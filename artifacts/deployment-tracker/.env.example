# Copy to .env and fill in for local development.
# Expo CLI auto-loads .env / .env.local in this directory — no extra wiring
# needed, unlike the Express apps. EXPO_PUBLIC_* vars are inlined into the
# JS bundle at build/start time (not private — anything here ships to the
# client. This is fine for a Maps key restricted by platform/bundle-id in
# Google Cloud Console, not fine for anything that must stay server-only).

# Local api-server, reachable from your phone over LAN (not "localhost")
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080

# Used only for the Directions API call in context/AppContext.tsx — separate
# from the native map-rendering key below, which is build-time, not env-var.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Native map rendering (react-native-maps) — NOT read from this .env ────
# app.json's ios.config.googleMapsApiKey / android.config.googleMaps.apiKey
# are currently hardcoded blank strings, baked in at build time via Expo's
# native prebuild — a plain .env can't reach them. Wiring this properly
# needs app.json converted to app.config.js (dynamic config) so it can read
# an env var, plus the same key supplied as an EAS build secret for real
# APK/EAS builds. Not needed for local Expo Go testing — Expo Go ships its
# own maps key for basic rendering.
