<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌊 WLS SMS Forwarder"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Automatically forwards WLS SMS alerts to your dashboard API"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:paddingBottom="20dp" />

        <!-- Status card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STATUS"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="14dp"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:fontFamily="monospace"
            android:layout_marginBottom="20dp" />

        <!-- Enable toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable forwarding"
                android:textColor="#F8FAFC"
                android:textSize="15sp" />
            <Switch
                android:id="@+id/sw_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- API URL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="API ENDPOINT URL"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/et_api_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="12dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#475569"
            android:hint="https://your-app.replit.app/api/wls/ingest"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="16dp" />

        <!-- Allowed senders -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ALLOWED SENDERS (comma-separated, empty = all)"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/et_senders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="12dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#475569"
            android:hint="CWS,winsystech"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="24dp" />

        <!-- Save button -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save Settings"
            android:backgroundTint="#0EA5E9"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Grant Permissions button -->
        <Button
            android:id="@+id/btn_permissions"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Grant Permissions"
            android:backgroundTint="#1E293B"
            android:textColor="#94A3B8"
            android:layout_marginBottom="12dp" />

        <!-- Test button -->
        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Send Test SMS to API"
            android:backgroundTint="#1E293B"
            android:textColor="#94A3B8"
            android:layout_marginBottom="24dp" />

        <!-- Instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HOW IT WORKS"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="14dp"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp"
            android:text="1. Grant SMS &amp; notification permissions above.\n\n2. The app listens silently in the background for incoming SMS from CWS or winsystech numbers.\n\n3. When a matching SMS arrives, it is immediately POSTed to your dashboard API endpoint.\n\n4. Use 'Send Test SMS' to verify connectivity before going live.\n\n5. This app does not store, read, or display your SMS messages — it only forwards WLS alerts to the configured URL." />

    </LinearLayout>
</ScrollView>
