# Copy to .env and fill in for local development.
# Note: vite.config.ts reads these via process.env — pnpm's dev script must
# actually load this file (Vite does not auto-load root-level .env outside
# import.meta.env by default for server-config-time reads like this one).

# Port Vite dev server listens on
PORT=5173

# Base path the app is served under (use "/" for local dev)
BASE_PATH=/
