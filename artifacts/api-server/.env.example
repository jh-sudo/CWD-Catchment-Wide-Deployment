# Copy to .env and fill in for local development.
# Node 20.6+ can load this directly: `node --env-file=.env ...`

# Local Postgres connection (see cwd-local-pg container)
DATABASE_URL=postgresql://cwd:cwd_local_dev@localhost:55432/cwd

# Any random string works for local dev — no fallback, server fails fast if unset
SESSION_SECRET=

# Port the API server listens on
PORT=8080

NODE_ENV=development
